# Notifications
desktop-notifications = true

# Auto Update
auto-update = download

# Shell Integration
shell-integration = none

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# Copy a terminal selection when one exists; otherwise forward Cmd+C to Neovim.
keybind = performable:cmd+c=copy_to_clipboard:mixed
# Forward Cmd+X to applications that support the Kitty keyboard protocol.
keybind = cmd+x=unbind

# VS Code-style Neovim shortcuts
keybind = cmd+s=unbind
keybind = cmd+p=unbind
keybind = cmd+shift+p=unbind
keybind = cmd+f=unbind
keybind = cmd+shift+f=unbind
keybind = cmd+z=unbind
keybind = cmd+shift+z=unbind
keybind = cmd+a=unbind

# Ghostty actions displaced by the Neovim shortcuts above
keybind = cmd+alt+f=start_search
keybind = cmd+alt+shift+f=end_search
keybind = cmd+alt+a=select_all
keybind = cmd+alt+shift+p=toggle_command_palette
keybind = cmd+alt+z=undo
keybind = cmd+alt+shift+z=redo

# Window
window-title-font-family = SF Mono
window-theme = system
window-colorspace = display-p3
window-save-state = always
window-padding-balance = true
macos-titlebar-style = transparent
title = " "
macos-titlebar-proxy-icon = hidden
# background-opacity = 0.95
maximize = true

# Theme
theme = TokyoNight Night

# Keep Japanese IME preedit text inline without an inverted block.
selection-background = cell-background
selection-foreground = #7dcfff

# Font
font-family = "PlemolJP Console NF"
font-codepoint-map = U+2190-U+21FF=SF Mono
font-codepoint-map = U+2300-U+23FF=SF Mono
font-size = 15
adjust-cell-height = 37.7%

# Cursor
cursor-style = block
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true

# Option key as Alt
macos-option-as-alt = left

# ==============================
# Keybindings for Claude Code
# ==============================

keybind = shift+enter=unbind

# Cmd+Enter -> Codex submit (Ctrl+Enter)
keybind = cmd+enter=unbind
keybind = cmd+enter=text:\x1b[13;5u

# ==============================
# Keybindings for herdr
# ==============================

# --- window ---

# Cmd+t -> new window
keybind = cmd+t=unbind
keybind = cmd+t=text:\x02c

# Cmd+w -> close tab
keybind = cmd+w=unbind
keybind = cmd+w=text:\x02X

# Cmd+1~9 -> select window
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind
keybind = cmd+one=text:\x021
keybind = cmd+two=text:\x022
keybind = cmd+three=text:\x023
keybind = cmd+four=text:\x024
keybind = cmd+five=text:\x025
keybind = cmd+six=text:\x026
keybind = cmd+seven=text:\x027
keybind = cmd+eight=text:\x028
keybind = cmd+nine=text:\x029

# Cmd+Shift+] -> next window
keybind = cmd+shift+bracket_right=text:\x02n

# Cmd+b -> toggle sidebar (herdr prefix+b)
keybind = cmd+b=text:\x02b

# Ctrl+q -> workspace selector (herdr goto = prefix+alt+g)
keybind = ctrl+q=text:\x02\x1bg

# --- popups ---

# Cmd+y -> Yazi
keybind = cmd+y=unbind
keybind = cmd+y=text:\x02Y

# Cmd+h -> Hunk (overrides the macOS Hide shortcut)
keybind = cmd+h=unbind
keybind = cmd+h=text:\x02H

# Cmd+l -> Lazygit
keybind = cmd+l=unbind
keybind = cmd+l=text:\x02L

# Cmd+j -> terminal (VS Code style)
keybind = cmd+j=unbind
keybind = cmd+j=text:\x02J

# --- pane ---

# Cmd+d -> split right (herdr split_vertical)
keybind = cmd+d=unbind
keybind = cmd+d=text:\x02v

# Cmd+Shift+d -> split down (herdr split_horizontal)
keybind = cmd+shift+d=unbind
keybind = cmd+shift+d=text:\x02-

# --- space ---

# Cmd+Shift+n -> new Space
keybind = cmd+shift+n=unbind
keybind = cmd+shift+n=text:\x02N

# Cmd+@ -> next Space
keybind = cmd+@=unbind
keybind = cmd+@=text:\x02@

# Cmd+Shift+@ -> previous Space
# On a JIS keyboard, Ghostty identifies the @ key as bracket_left.
keybind = cmd+shift+bracket_left=text:\x02`
